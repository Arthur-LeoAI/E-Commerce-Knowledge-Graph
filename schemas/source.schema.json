{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arthur-LeoAI/E-Commerce-Knowledge-Graph/schemas/source.schema.json",
  "title": "Cited source from the prototype",
  "type": "object",
  "required": ["id", "title", "publisher", "url", "accessed"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "title": { "$ref": "common.schema.json#/$defs/nonEmpty" },
    "publisher": { "$ref": "common.schema.json#/$defs/text" },
    "url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "accessed": { "$ref": "common.schema.json#/$defs/date" }
  }
}
