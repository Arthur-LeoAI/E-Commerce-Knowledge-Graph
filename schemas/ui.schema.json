{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arthur-LeoAI/E-Commerce-Knowledge-Graph/schemas/ui.schema.json",
  "title": "Interface strings: key to text in both languages",
  "type": "object",
  "propertyNames": { "pattern": "^[A-Za-z0-9_]+$" },
  "additionalProperties": {
    "anyOf": [
      { "$ref": "common.schema.json#/$defs/text" },
      {
        "description": "List of strings; may contain empty placeholders (e.g. index 0 of level names, which are 1-based)",
        "type": "object",
        "required": ["en", "zh"],
        "additionalProperties": false,
        "properties": {
          "en": { "type": "array", "items": { "type": "string" } },
          "zh": { "type": "array", "items": { "type": "string" } }
        }
      }
    ]
  }
}
